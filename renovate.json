{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["dependencies"],
  "dependencyDashboard": true,
  "extends": ["config:recommended", "group:allNonMajor", ":semanticCommitTypeAll(fix)", "security:minimumReleaseAgeNpm"],
  "ignoreDeps": ["@types/node", "node"],
  "packageRules": [
    {
      "description": "runed 0.38+ targets SvelteKit 3 goto options; hold until the Kit 3 upgrade",
      "matchPackageNames": ["runed"],
      "allowedVersions": "<0.38.0"
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "groupName": "houdini",
      "matchPackagePrefixes": ["houdini"],
      "matchUpdateTypes": ["major"]
    }
  ],
  "rangeStrategy": "bump"
}
