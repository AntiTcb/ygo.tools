{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "vitest/globals"],
    // Mirrors package.json "imports": `svelte-check --tsgo` (4.7.7) leaves `.svelte` files imported
    // through subpath imports untyped, so it needs these to type-check component props.
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*", "src/routes/sitemap[[page]].xml/+server.ts", "worker-configuration.d.ts"],
  "exclude": ["src/workers/**"]
}
