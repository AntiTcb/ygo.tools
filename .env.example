CF_ACCESS_AUD=
# Effect search scripts (pnpm effect-search:*): Workers AI REST token with Account > Workers AI > Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
