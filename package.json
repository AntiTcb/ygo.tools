{
  "name": "ygo.tools",
  "version": "0.8.0",
  "private": true,
  "repository": "https://github.com/AntiTcb/ygo.tools",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run types && wrangler dev .svelte-kit/cloudflare/_worker.js",
    "cf:deploy": "pnpm run types && pnpm run build && wrangler deploy",
    "check": "pnpm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "pnpm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "types": "wrangler types",
    "event-map:migrate:local": "wrangler d1 migrations apply ygo-event-map --local",
    "event-map:migrate:remote": "wrangler d1 migrations apply ygo-event-map --remote",
    "event-map:scraper": "wrangler dev -c wrangler.event-scraper.jsonc --test-scheduled",
    "event-map:scraper:deploy": "wrangler deploy -c wrangler.event-scraper.jsonc",
    "event-map:seed-venues": "node scripts/event-map-seed-venues.mjs",
    "db:types": "dotenv -e .env.local -- node scripts/gen-db-types.mjs",
    "effect-search:gen-vocab": "dotenv -e .env.local -- node scripts/effect-search-gen-vocab.mjs",
    "effect-search:tag": "dotenv -e .env.local -- tsx scripts/effect-search/tag.ts",
    "effect-search:eval": "dotenv -e .env.local -- tsx scripts/effect-search/eval.ts",
    "effect-search:gold": "dotenv -e .env.local -- tsx scripts/effect-search/gold.ts",
    "effect-search:backfill": "dotenv -e .env.local -- tsx scripts/effect-search/backfill.ts",
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "effect-search:sample": "dotenv -e .env.local -- tsx scripts/effect-search/sample.ts",
    "check:workers": "tsc -p src/workers/tsconfig.json",
    "effect-tagger:deploy": "wrangler deploy -c wrangler.effect-tagger.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.97",
    "@macfja/svelte-persistent-store": "^2.4.2",
    "@photostructure/tz-lookup": "^11.8.0",
    "@playwright/test": "^1.65.0",
    "@skeletonlabs/skeleton": "^5.0.4",
    "@skeletonlabs/skeleton-svelte": "^5.0.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "fullcalendar": "^7.1.4",
    "lefthook": "^2.2.2",
    "mapbox-gl": "^3.34.2",
    "node-html-parser": "^9.0.7",
    "nprogress": "^0.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "runed": "^0.38.0",
    "supabase": "^2.122.1",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-meta-tags": "^5.0.3",
    "svelte-search": "^2.1.2",
    "svelte-sonner": "^1.2.3",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.8",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
