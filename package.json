{
  "name": "ygo.tools",
  "version": "0.6.0",
  "private": true,
  "repository": "https://github.com/AntiTcb/ygo.tools",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run types && wrangler dev .svelte-kit/cloudflare/_worker.js",
    "cf:deploy": "pnpm run types && pnpm run build && wrangler deploy --env=production",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.68",
    "@macfja/svelte-persistent-store": "^2.4.2",
    "@playwright/test": "^1.62.1",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.1.10",
    "nprogress": "^0.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "runed": "^0.37.1",
    "sk-seo": "^0.5.4",
    "supabase": "^2.111.0",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-search": "^2.1.2",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
