{
  "name": "ygo.tools",
  "version": "0.8.0",
  "private": true,
  "repository": "https://github.com/AntiTcb/ygo.tools",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run types && wrangler dev .svelte-kit/cloudflare/_worker.js",
    "cf:deploy": "pnpm run types && pnpm run build && wrangler deploy --env=production",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "types": "wrangler types",
    "event-map:migrate:local": "wrangler d1 migrations apply ygo-event-map --local",
    "event-map:migrate:remote": "wrangler d1 migrations apply ygo-event-map --remote",
    "event-map:scraper": "wrangler dev -c wrangler.event-scraper.jsonc --test-scheduled",
    "event-map:scraper:deploy": "wrangler deploy -c wrangler.event-scraper.jsonc",
    "event-map:seed-venues": "node scripts/event-map-seed-venues.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.85",
    "@macfja/svelte-persistent-store": "^2.4.2",
    "@photostructure/tz-lookup": "^11.7.0",
    "@playwright/test": "^1.63.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/nprogress": "^0.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "fullcalendar": "^7.1.1",
    "lefthook": "^2.1.17",
    "mapbox-gl": "^3.32.0",
    "node-html-parser": "^9.0.4",
    "nprogress": "^0.2.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "runed": "^0.37.1",
    "sk-seo": "^0.5.4",
    "supabase": "^2.119.0",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-search": "^2.1.2",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=12.8.2"
  },
  "packageManager": "pnpm@12.8.2",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
