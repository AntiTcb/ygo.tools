{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ygotools",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "PUBLIC_MAPBOX_TOKEN": "pk.eyJ1IjoiYW50aXRjYiIsImEiOiJjbXV2djd4cmMwN3g0MnlteXBydmNrYm5kIn0.BlJjusx5QfENLMksinjajg",
    "PUBLIC_SUPABASE_URL": "https://sbygo.alexgravely.dev",
    "PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc0NDY2MjkwMCwiZXhwIjo0OTAwMzM2NTAwLCJyb2xlIjoiYW5vbiJ9.hufXok3PvE4Q-mh5N_djtIxBMOY5yPxeM6vMLoKCifE",
    "NOMINATIM_CONTACT": "https://ygo.tools",
  },
  "d1_databases": [
    {
      // /event-map events and geocoded venues (written by the scraper Worker in wrangler.event-scraper.jsonc).
      "binding": "EVENT_MAP_DB",
      "database_name": "ygo-event-map",
      "database_id": "1a994d9b-4a5a-4ae9-9e09-13fc61927345",
      "migrations_dir": "migrations/event-map",
    },
  ],
  // /search: Workers AI parses requests into queries; at most 10 model calls per minute per IP.
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "SEARCH_PARSE_LIMITER",
      "namespace_id": "1101",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  // Effect search tagging runs (/admin "Run now"); the Workflow lives in wrangler.effect-tagger.jsonc.
  "workflows": [
    {
      "binding": "EFFECT_TAG_WORKFLOW",
      "name": "effect-tag-workflow",
      "class_name": "EffectTagWorkflow",
      "script_name": "ygotools-effect-tagger",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "previews": {
    "vars": {
      "PUBLIC_MAPBOX_TOKEN": "pk.eyJ1IjoiYW50aXRjYiIsImEiOiJjbXV2djd4cmMwN3g0MnlteXBydmNrYm5kIn0.BlJjusx5QfENLMksinjajg",
      "PUBLIC_SUPABASE_URL": "https://sbygo.alexgravely.dev",
      "PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc0NDY2MjkwMCwiZXhwIjo0OTAwMzM2NTAwLCJyb2xlIjoiYW5vbiJ9.hufXok3PvE4Q-mh5N_djtIxBMOY5yPxeM6vMLoKCifE",
      "NOMINATIM_CONTACT": "https://ygo.tools",
    },
    // Previews inherit no bindings from the top level. These share production's resources,
    // except the rate limiter, which counts separately.
    "d1_databases": [
      {
        "binding": "EVENT_MAP_DB",
        "database_name": "ygo-event-map",
        "database_id": "1a994d9b-4a5a-4ae9-9e09-13fc61927345",
        "migrations_dir": "migrations/event-map",
      },
    ],
    "ai": {
      "binding": "AI",
    },
    "ratelimits": [
      {
        "name": "SEARCH_PARSE_LIMITER",
        "namespace_id": "1102",
        "simple": {
          "limit": 10,
          "period": 60,
        },
      },
    ],
    "workflows": [
      {
        "binding": "EFFECT_TAG_WORKFLOW",
        "name": "effect-tag-workflow",
        "class_name": "EffectTagWorkflow",
        "script_name": "ygotools-effect-tagger",
      },
    ],
  },
  "env": {
    "production": {
      "vars": {
        "PUBLIC_SUPABASE_URL": "https://sbygo.alexgravely.dev",
        "PUBLIC_SUPABASE_ANON_KEY": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc0NDY2MjkwMCwiZXhwIjo0OTAwMzM2NTAwLCJyb2xlIjoiYW5vbiJ9.hufXok3PvE4Q-mh5N_djtIxBMOY5yPxeM6vMLoKCifE",
        "PUBLIC_MAPBOX_TOKEN": "pk.eyJ1IjoiYW50aXRjYiIsImEiOiJjbXV2djd4cmMwN3g0MnlteXBydmNrYm5kIn0.BlJjusx5QfENLMksinjajg",
        "NOMINATIM_CONTACT": "https://ygo.tools",
      },
      // Bindings aren't inherited by named environments.
      "d1_databases": [
        {
          "binding": "EVENT_MAP_DB",
          "database_name": "ygo-event-map",
          "database_id": "1a994d9b-4a5a-4ae9-9e09-13fc61927345",
          "migrations_dir": "migrations/event-map",
        },
      ],
      "ai": {
        "binding": "AI",
      },
      "ratelimits": [
        {
          "name": "SEARCH_PARSE_LIMITER",
          "namespace_id": "1101",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "workflows": [
        {
          "binding": "EFFECT_TAG_WORKFLOW",
          "name": "effect-tag-workflow",
          "class_name": "EffectTagWorkflow",
          "script_name": "ygotools-effect-tagger",
        },
      ],
      "routes": [
        {
          "custom_domain": true,
          "pattern": "ygo.tools",
        },
      ],
    },
  },
}
